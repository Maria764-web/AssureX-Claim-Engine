{
  "policy_id": "WP-STD-ELEC-001",
  "policy_name": "Standard Electronics Warranty",
  "display_name": "Standard Electronics",
  "version": "1.0",
  "effective_date": "2026-01-01",

  "coverage": {
    "duration_months": 12,
    "max_claims_per_product": 2,
    "max_claim_value_pkr": 50000,
    "covers_parts": true,
    "covers_labour": false
  },

  "eligible_product_categories": [
    "Laptop",
    "Desktop PC",
    "Monitor",
    "Printer",
    "Television",
    "Audio Equipment"
  ],

  "covered_damage_types": [
    "Manufacturing Defect",
    "Electrical Fault",
    "Battery Failure",
    "Display Fault",
    "Hardware Malfunction"
  ],

  "excluded_damage_types": [
    "Physical Damage",
    "Accidental Damage",
    "Water Damage",
    "Screen Crack",
    "User Negligence",
    "Theft",
    "Fire Damage",
    "Cosmetic Damage"
  ],

  "required_documents": [
    "Original Purchase Receipt or Invoice",
    "Damage Photo (minimum 2 images)"
  ],

  "optional_documents": [
    "Technician Diagnostic Report",
    "Serial Number Verification Letter"
  ],

  "auto_rejection_conditions": [
    "Warranty period expired at time of claim",
    "Damage type in excluded_damage_types list",
    "Max claims per product exceeded",
    "Serial number mismatch with registered product",
    "Claim submitted more than 30 days after fault discovery"
  ],

  "auto_approval_conditions": [
    "All warranty rules pass",
    "ML model confidence >= 0.80 for Valid class",
    "No duplicate claim detected",
    "No contradiction detected in claim data"
  ],

  "manual_review_triggers": [
    "ML model confidence between 0.60 and 0.80",
    "Contradiction detected in claim timeline",
    "Borderline product age",
    "Incomplete documentation"
  ],

  "notes": "Standard 12-month warranty covering manufacturing defects and electrical faults for consumer electronics. Physical and accidental damage is excluded. Customer must provide original receipt and damage photographs."
}
