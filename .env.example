# ==============================================================================
# AssureX Claim Engine - Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Flask Core Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=assurex_dev_secret_key_change_in_production_3b83d99f

# Database Configuration (SQLite default for development)
# Use sqlite:///assurex.db or absolute path sqlite:////path/to/assurex.db
DATABASE_URL=sqlite:///assurex.db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,mp4,doc,docx

# SMTP Configuration (For future notification support)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=notifications@assurex.local
MAIL_PASSWORD=your_smtp_password_placeholder
MAIL_DEFAULT_SENDER=AssureX Notifications <noreply@assurex.local>

# AI Models & Decision Engine (Future Steps)
PYTHON_MODEL_PATH=ai_models/claim_classifier.joblib
TEACHABLE_MACHINE_MODEL_URL=https://teachablemachine.withgoogle.com/models/sample/
CONFIDENCE_THRESHOLD=0.75
